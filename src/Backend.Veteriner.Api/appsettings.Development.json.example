{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "QueryConnection": ""
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "LuckyPennySoftware.MediatR.License": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "LuckyPennySoftware.MediatR.License": "None"
    }
  },

  "Outbox": {
    "Enabled": true,
    "MaxRetryCount": 10,
    "BaseDelaySeconds": 5,
    "BatchSize": 10,
    "LoopIntervalSeconds": 60
  },

  "AppointmentProjection": {
    "Enabled": true,
    "BatchSize": 50,
    "LoopIntervalSeconds": 2,
    "ConsumerName": "appointment-read-model-v1",
    "ClaimingEnabled": false,
    "LeaseDurationSeconds": 60,
    "ClaimBatchSize": 1
  },

  "AppointmentProjectionHealth": {
    "DegradedAfterSeconds": 10,
    "UnhealthyAfterSeconds": 60,
    "DeadLetterIsUnhealthy": true
  },

  "ClientProjectionHealth": {
    "DegradedAfterSeconds": 10,
    "UnhealthyAfterSeconds": 60,
    "DeadLetterIsUnhealthy": true
  },

  "ClientProjection": {
    "Enabled": true,
    "BatchSize": 50,
    "LoopIntervalSeconds": 2,
    "ConsumerName": "client-read-model-v1",
    "ClaimingEnabled": false,
    "LeaseDurationSeconds": 60,
    "ClaimBatchSize": 1
  },

  "PetProjectionHealth": {
    "DegradedAfterSeconds": 10,
    "UnhealthyAfterSeconds": 60,
    "DeadLetterIsUnhealthy": true
  },

  "PetProjection": {
    "Enabled": false,
    "BatchSize": 50,
    "LoopIntervalSeconds": 2,
    "ConsumerName": "pet-read-model-v1",
    "ClaimingEnabled": false,
    "LeaseDurationSeconds": 60,
    "ClaimBatchSize": 1
  },

  "PaymentProjectionHealth": {
    "DegradedAfterSeconds": 10,
    "UnhealthyAfterSeconds": 60,
    "DeadLetterIsUnhealthy": true
  },

  "PaymentProjection": {
    "Enabled": false,
    "BatchSize": 50,
    "LoopIntervalSeconds": 2,
    "ConsumerName": "payment-finance-v1",
    "ClaimingEnabled": false,
    "LeaseDurationSeconds": 60,
    "ClaimBatchSize": 1
  },

  "QueryReadModels": {
    "AppointmentsEnabled": false,
    "DashboardAppointmentsEnabled": false,
    "DashboardFinanceReadEnabled": false,
    "ClientsEnabled": false,
    "PetsEnabled": false,
    "SharedSearchLookupEnabled": false,
    "PaymentsSearchLookupEnabled": false,
    "PaymentsListReadEnabled": false,
    "DashboardRecentPaymentsReadEnabled": false,
    "ClientPaymentSummaryReadEnabled": false,
    "PaymentsReportReadEnabled": false,
    "PaymentsReportExportReadEnabled": false,
    "PaymentsGetByIdReadEnabled": false
  },

  "RefreshTokenCleanup": {
    "Enabled": false,
    "InitialDelaySeconds": 300,
    "IntervalMinutes": 360,
    "RetentionDays": 30,
    "BatchSize": 2000
  },

  "Reminders": {
    "Processor": {
      "Enabled": true,
      "IntervalMinutes": 5,
      "BatchSize": 100,
      "WindowToleranceMinutes": 10,
      "LegacyEnqueuedReconcileAfterMinutes": 30
    }
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": false,
    "UseStartTls": true,
    "User": "",
    "Pass": "",
    "FromName": "Vetinity",
    "From": ""
  },

  "App": {
    "FrontendBaseUrl": "http://localhost:4200"
  },

  "FileStorage": {
    "RootPath": "C:\\VetinityData\\files"
  },

  "PermissionChange": {
    "RevokeSessionsOnPermissionChange": false
  },

  "Billing": {
    "DefaultCheckoutProvider": "Iyzico",
    "ScheduledPlanChangeProcessor": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "BatchSize": 50
    },
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "SuccessUrl": "",
      "CancelUrl": "",
      "SubscriptionPriceIds": {
        "Basic": "",
        "Pro": "",
        "Premium": ""
      }
    },
    "Iyzico": {
      "ApiKey": "",
      "SecretKey": "",
      "MerchantId": "",
      "BaseUrl": "",
      "CallbackUrl": "",
      "ReturnSuccessUrl": "",
      "ReturnFailureUrl": "",
      "PlanPricesTry": {
        "Basic": 999.90,
        "Pro": 1999.90,
        "Premium": 2999.90
      },
      "WebhookSecret": "",
      "AllowUnsignedSandboxWebhooks": true,
      "Locale": "tr",
      "Country": "Turkey",
      "City": "Istanbul",
      "SandboxBuyerIp": ""
    }
  }
}
