# EditorConfig: https://editorconfig.org
# Proje kökü - tüm kaynak dosyalar UTF-8 ile tutulur (Türkçe karakter uyumu)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,json,md}]
charset = utf-8

[*.cs]
indent_style = space
indent_size = 4

# Saat kaynagi kurali (BannedSymbols.txt, Domain + Application): mevcut 180+ kullanim kademeli temizlenecek; o yuzden
# oneri seviyesinde (IDE gosterir, derleme uyarisi vermez). Temizlik bitince warning/error yapilir.
dotnet_diagnostic.RS0030.severity = suggestion

[tests/**/*.cs]
# xUnit v3 analizoru (xUnit1051): CancellationToken alan cagrilara TestContext.Current.CancellationToken onerir.
# Mevcut ~3000 cagri noktasi icin toplu degisiklik yapilmadi; yeni testlerde tercih edilir.
dotnet_diagnostic.xUnit1051.severity = suggestion
